  // ── Top-level Tournaments navigation ──────────────────────────────────────
  $items['tournaments'] = array(
    'title'            => 'Tournaments',
    'page callback'    => 'pool_tournament_tournaments_page',
    'access arguments' => array('access content'),
    'type'             => MENU_NORMAL_ITEM,
    'menu_name'        => 'main-menu',

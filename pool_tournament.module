/**
 * Implements hook_permission().
 */
function pool_tournament_permission() {
  return array(
    'administer pool tournament' => array(
      'title'       => t('Administer Pool Tournament'),
      'description' => t('Create and manage all pool tournament entities, bundles, and settings.'),
      'restrict access' => TRUE,
    ),
    'manage players' => array(
      'title'       => t('Manage players'),
      'description' => t('Create, edit, and delete player records.'),
    ),
    'view players' => array(
      'title' => t('View player profiles'),
    ),
    'edit own player' => array(
      'title'       => t('Edit own player profile'),
      'description' => t('Allows a user to edit the player record linked to their account.'),
    ),
    'manage pool entities' => array(
      'title'       => t('Manage pool reference entities'),
      'description' => t('Create and edit game types, player types, tournament types, and venues.'),
    ),
  );
}

/**
 * Access callback for all pool tournament entities.
 */
function pool_tournament_entity_access($op, $entity, $account = NULL, $entity_type = NULL) {
  if (!isset($account)) {
    $account = $GLOBALS['user'];
  }
  if (user_access('administer pool tournament', $account)) {
    return TRUE;
  }
  if ($entity_type === 'player') {
    if ($op === 'view') {
      return user_access('view players', $account);
    }
    if (($op === 'update' || $op === 'edit') && isset($entity->uid) && $entity->uid == $account->uid) {
      return user_access('edit own player', $account);
    }
    return user_access('manage players', $account);
  }
  // For all other entity types, require manage permission.
  return user_access('manage pool entities', $account);
}


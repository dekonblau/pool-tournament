/**
 * Implements hook_entity_info_alter().
 *
 * Populates bundles from config for all five entity types.
 */
function pool_tournament_entity_info_alter(&$entity_info) {
  $definitions = array(
    'player'          => array('config_prefix' => 'player.bundle',          'admin_base' => 'admin/structure/player-bundle'),
    'player_type'     => array('config_prefix' => 'player_type.bundle',     'admin_base' => 'admin/structure/player-type-bundle'),
    'game_type'       => array('config_prefix' => 'game_type.bundle',       'admin_base' => 'admin/structure/game-type-bundle'),
    'tournament_type' => array('config_prefix' => 'tournament_type.bundle', 'admin_base' => 'admin/structure/tournament-type-bundle'),
    'venue'           => array('config_prefix' => 'venue.bundle',           'admin_base' => 'admin/structure/venue-bundle'),
    'sanctioning_body' => array('config_prefix' => 'sanctioning_body.bundle', 'admin_base' => 'admin/structure/sanctioning-body-bundle'),
  );

  foreach ($definitions as $entity_type => $def) {
    if (!isset($entity_info[$entity_type])) {
      continue;
    }
    $names = config_get_names_with_prefix($def['config_prefix'] . '.');
    foreach ($names as $config_name) {
      $config = config_get($config_name);
      if (empty($config['bundle'])) {
        continue;
      }
      $bundle = $config['bundle'];
      $entity_info[$entity_type]['bundles'][$bundle] = array(
        'label' => $config['label'],
        'admin' => array(
          'path'            => $def['admin_base'] . '/' . $bundle,
          'real path'       => $def['admin_base'] . '/' . $bundle,
          'bundle argument' => substr_count($def['admin_base'], '/'),
          'access arguments' => array('administer pool tournament'),
        ),
      );
    }
  }
}


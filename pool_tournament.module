  $items['admin/config/pool-tournament'] = array(
    'title'            => 'Pool Tournament',
    'description'      => 'Configure the pool tournament module.',
    'page callback'    => 'system_admin_menu_block_page',
    'access arguments' => array('administer pool tournament'),
    'file'             => 'system.admin.inc',
    'file path'        => backdrop_get_path('module', 'system'),
    'type'             => MENU_NORMAL_ITEM,
  );
  $items['admin/config/pool-tournament/settings'] = array(
    'title'            => 'Settings',
    'description'      => 'Bracket manager API connection and Fargo Rate settings.',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_settings_form'),
    'access arguments' => array('administer pool tournament'),
    'file'             => 'includes/pool_tournament.admin.inc',
    'type'             => MENU_NORMAL_ITEM,
  );

  // ── Players ────────────────────────────────────────────────────────────────
  $items['players'] = array(
    'title'            => 'Players',
    'page callback'    => 'pool_tournament_player_list_page',
    'access arguments' => array('view players'),
    'type'             => MENU_NORMAL_ITEM,
  );
  $items['player/add'] = array(
    'title'            => 'Add player',
    'page callback'    => 'pool_tournament_player_add_page',
    'access arguments' => array('manage players'),
    'type'             => MENU_LOCAL_ACTION,
  );
  $items['player/add/%pool_tournament_player_bundle'] = array(
    'title callback'   => 'pool_tournament_player_add_title',
    'title arguments'  => array(2),
    'page callback'    => 'pool_tournament_player_add_form_page',
    'page arguments'   => array(2),
    'access arguments' => array('manage players'),
  );
  $items['player/%pool_tournament_player'] = array(
    'title callback'   => 'pool_tournament_entity_label',
    'title arguments'  => array(1),
    'page callback'    => 'pool_tournament_player_view_page',
    'page arguments'   => array(1),
    'access callback'  => 'pool_tournament_entity_access',
    'access arguments' => array('view', 1),
    'load arguments'   => array('%map', '%index'),
  );
  $items['player/%pool_tournament_player/view'] = array(
    'title'  => 'View',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );
  $items['player/%pool_tournament_player/edit'] = array(
    'title'            => 'Edit',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_form', 1),
    'access callback'  => 'pool_tournament_entity_access',
    'access arguments' => array('update', 1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.forms.inc',
  );
  $items['player/%pool_tournament_player/delete'] = array(
    'title'            => 'Delete',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_delete_form', 1),
    'access callback'  => 'pool_tournament_entity_access',
    'access arguments' => array('delete', 1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.forms.inc',
  );
  $items['player/%pool_tournament_player/preferences'] = array(
    'title'            => 'Tournament preferences',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_preferences_form', 1),
    'access callback'  => 'pool_tournament_player_preferences_access',
    'access arguments' => array(1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.forms.inc',
  );

  // ── Player bundle admin ────────────────────────────────────────────────────
  $items['admin/structure/player-bundle'] = array(
    'title'            => 'Player bundles',
    'page callback'    => 'pool_tournament_bundle_list_page',
    'page arguments'   => array('player', 'player.bundle', 'admin/structure/player-bundle'),
    'access arguments' => array('administer pool tournament'),
    'file'             => 'includes/pool_tournament.admin.inc',
  );
  $items['admin/structure/player-bundle/add'] = array(
    'title'            => 'Add bundle',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_bundle_form', 'player.bundle'),
    'access arguments' => array('administer pool tournament'),
    'type'             => MENU_LOCAL_ACTION,
    'file'             => 'includes/pool_tournament.admin.inc',
  );
  // Per-bundle admin page, one literal path per existing bundle. Field UI
  // reads entity_info's bundle 'admin'.'path' key literally (it does not
  // do wildcard matching when generating its own "Manage fields" / "Manage
  // displays" tabs — see field_ui_menu()), so each bundle needs its own
  // real, non-wildcard menu item here for those tabs to attach to instead
  // of collapsing onto the bundle list page above.
  foreach (_pool_tournament_bundle_list('player.bundle') as $bundle => $config) {
    $items['admin/structure/player-bundle/' . $bundle] = array(
      'title'            => isset($config['label']) ? $config['label'] : $bundle,
      'page callback'    => 'backdrop_get_form',
      'page arguments'   => array('pool_tournament_bundle_form', 'player.bundle', $bundle),
      'access arguments' => array('administer pool tournament'),
      'file'             => 'includes/pool_tournament.admin.inc',
    );
    $items['admin/structure/player-bundle/' . $bundle . '/edit'] = array(
      'title'  => 'Edit',
      'type'   => MENU_DEFAULT_LOCAL_TASK,
    );
    $items['admin/structure/player-bundle/' . $bundle . '/delete'] = array(
      'title'            => 'Delete',
      'page callback'    => 'backdrop_get_form',
      'page arguments'   => array('pool_tournament_bundle_delete_form', 'player.bundle', $bundle),
      'access arguments' => array('administer pool tournament'),
      'type'             => MENU_LOCAL_TASK,
      'file'             => 'includes/pool_tournament.admin.inc',
    );
  }

  // ── Reference entity routes (player_type, game_type, tournament_type, venue, sanctioning_body) ─
  $ref_entities = array(
    'player_type'     => array('path' => 'player-type',     'title' => 'Player Types',     'config' => 'player_type.bundle',     'id_key' => 'player_type_id'),
    'game_type'       => array('path' => 'game-type',       'title' => 'Game Types',       'config' => 'game_type.bundle',       'id_key' => 'game_type_id'),
    'tournament_type' => array('path' => 'tournament-type', 'title' => 'Tournament Types', 'config' => 'tournament_type.bundle', 'id_key' => 'tournament_type_id'),
    'venue'           => array('path' => 'venue',           'title' => 'Venues',           'config' => 'venue.bundle',           'id_key' => 'venue_id'),
    'sanctioning_body' => array('path' => 'sanctioning-body', 'title' => 'Sanctioning Bodies', 'config' => 'sanctioning_body.bundle', 'id_key' => 'sanctioning_body_id'),
  );

  foreach ($ref_entities as $entity_type => $def) {
    $p = $def['path'];
    $t = $def['title'];
    $c = $def['config'];
    $k = $def['id_key'];
    $admin_base = 'admin/structure/' . $p . '-bundle';

    // List page.
    $items[$p . 's'] = array(
      'title'            => $t,
      'page callback'    => 'pool_tournament_ref_entity_list_page',
      'page arguments'   => array($entity_type),
      'access arguments' => array('manage pool entities'),
    );
    // Add (select bundle).
    $items[$p . '/add'] = array(
      'title'            => 'Add ' . $p,
      'page callback'    => 'pool_tournament_ref_entity_add_page',
      'page arguments'   => array($entity_type, $p),
      'access arguments' => array('manage pool entities'),
      'type'             => MENU_LOCAL_ACTION,
    );
    // Add specific bundle.
    $items[$p . '/add/%'] = array(
      'title'            => 'Add ' . $p,
      'page callback'    => 'pool_tournament_ref_entity_add_form_page',
      'page arguments'   => array($entity_type, 2, $k, $p . 's'),
      'access arguments' => array('manage pool entities'),
    );
    // View/edit/delete.
    $items[$p . '/%pool_tournament_' . str_replace('-', '_', $p)] = array(
      'title callback'   => 'pool_tournament_entity_label',
      'title arguments'  => array(1),
      'page callback'    => 'pool_tournament_ref_entity_view',
      'page arguments'   => array($entity_type, 1),
      'access arguments' => array('manage pool entities'),
    );
    $items[$p . '/%pool_tournament_' . str_replace('-', '_', $p) . '/edit'] = array(
      'title'            => 'Edit',
      'page callback'    => 'backdrop_get_form',
      'page arguments'   => array('pool_tournament_generic_entity_form', $entity_type, 1, $k, $p . 's'),
      'access arguments' => array('manage pool entities'),
      'type'             => MENU_LOCAL_TASK,
      'file'             => 'includes/pool_tournament.forms.inc',
    );
    $items[$p . '/%pool_tournament_' . str_replace('-', '_', $p) . '/delete'] = array(
      'title'            => 'Delete',
      'page callback'    => 'backdrop_get_form',
      'page arguments'   => array('pool_tournament_ref_entity_delete_form', $entity_type, 1, $p . 's'),
      'access arguments' => array('manage pool entities'),
      'type'             => MENU_LOCAL_TASK,
      'file'             => 'includes/pool_tournament.forms.inc',
    );

    // Bundle admin.
    $items[$admin_base] = array(
      'title'            => $t . ' bundles',
      'page callback'    => 'pool_tournament_bundle_list_page',
      'page arguments'   => array($entity_type, $c, $admin_base),
      'access arguments' => array('administer pool tournament'),
      'file'             => 'includes/pool_tournament.admin.inc',
    );
    $items[$admin_base . '/add'] = array(
      'title'            => 'Add bundle',
      'page callback'    => 'backdrop_get_form',
      'page arguments'   => array('pool_tournament_bundle_form', $c),
      'access arguments' => array('administer pool tournament'),
      'type'             => MENU_LOCAL_ACTION,
      'file'             => 'includes/pool_tournament.admin.inc',
    );
    // Per-bundle admin page, one literal path per existing bundle (see the
    // equivalent player-bundle comment above for why this is required for
    // Field UI's tabs to attach correctly).
    foreach (_pool_tournament_bundle_list($c) as $bundle => $bundle_config) {
      $items[$admin_base . '/' . $bundle] = array(
        'title'            => isset($bundle_config['label']) ? $bundle_config['label'] : $bundle,
        'page callback'    => 'backdrop_get_form',
        'page arguments'   => array('pool_tournament_bundle_form', $c, $bundle),
        'access arguments' => array('administer pool tournament'),
        'file'             => 'includes/pool_tournament.admin.inc',
      );
      $items[$admin_base . '/' . $bundle . '/edit'] = array(
        'title'  => 'Edit',
        'type'   => MENU_DEFAULT_LOCAL_TASK,
      );
      $items[$admin_base . '/' . $bundle . '/delete'] = array(
        'title'            => 'Delete',
        'page callback'    => 'backdrop_get_form',
        'page arguments'   => array('pool_tournament_bundle_delete_form', $c, $bundle),
        'access arguments' => array('administer pool tournament'),
        'type'             => MENU_LOCAL_TASK,
        'file'             => 'includes/pool_tournament.admin.inc',
      );
    }
  }

  // ── Tournament registration -- self-service and TD/admin roster ────────────
  $items['node/%node/register'] = array(
    'title'            => 'Register',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_registration_self_form', 1),
    'access callback'  => 'pool_tournament_registration_self_access',
    'access arguments' => array(1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.registration.inc',
  );
  $items['node/%node/roster'] = array(
    'title'            => 'Roster',
    'page callback'    => 'pool_tournament_tournament_roster_page',
    'page arguments'   => array(1),
    'access callback'  => 'pool_tournament_tournament_td_access',
    'access arguments' => array(1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.registration.inc',
  );
  $items['node/%node/roster/%/remove'] = array(
    'title'            => 'Remove from roster',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_roster_remove_form', 1, 3),
    'access callback'  => 'pool_tournament_tournament_td_access',
    'access arguments' => array(1),
    'file'             => 'includes/pool_tournament.registration.inc',
  );
  $items['node/%node/in-play'] = array(
    'title'            => 'In play',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_tournament_in_play_form', 1),
    'access callback'  => 'pool_tournament_tournament_td_access',
    'access arguments' => array(1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.registration.inc',
  );

  return $items;
}

// ---------------------------------------------------------------------------
// Menu wildcard loaders
// ---------------------------------------------------------------------------

function pool_tournament_player_load($player_id) {
  return entity_load('player', $player_id);
}
function pool_tournament_player_bundle_load($bundle) {
  $config = config_get('player.bundle.' . $bundle);
  return $config ?: FALSE;
}
function pool_tournament_player_type_load($id) { return entity_load('player_type', $id); }
function pool_tournament_game_type_load($id)   { return entity_load('game_type',   $id); }
function pool_tournament_tournament_type_load($id) { return entity_load('tournament_type', $id); }
function pool_tournament_venue_load($id)       { return entity_load('venue', $id); }
function pool_tournament_sanctioning_body_load($id) { return entity_load('sanctioning_body', $id); }

/**
 * Menu title callback / generic label getter for our entity classes.
 */
function pool_tournament_entity_label($entity) {
  return $entity->label();
}

// ---------------------------------------------------------------------------
// Page callbacks
// ---------------------------------------------------------------------------

/**
 * /tournaments — upcoming tournaments filtered by logged-in player preferences.
 */
function pool_tournament_tournaments_page() {
  global $user;

  // Build a Views embed if the view exists, otherwise fall back to a node
  // query. No pool_tournament_upcoming View ships with this module, so in
  // practice this always falls through to the query below -- which is why
  // that query, not hook_views_query_alter(), is where preference filtering
  // actually has to happen for it to do anything.
  if (module_exists('views') && ($view = views_get_view('pool_tournament_upcoming'))) {
    $output = $view->preview('page');
    if (!empty($output)) {
      return $output;
    }
  }

  $query = db_select('node', 'n')
    ->fields('n', array('nid', 'title'))
    ->condition('n.type', 'tournament')
    ->condition('n.status', 1);

  // Filter by the logged-in player's preferences, if any are set.
  $prefs = array();
  if ($user->uid) {
    $player = pool_tournament_player_for_user($user->uid);
    if ($player) {
      module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.forms');
      $prefs = _pool_tournament_player_preferences_load($player->id());
    }
  }

  foreach (_pool_tournament_preference_field_map() as $ptype => $field_name) {
    if (empty($prefs[$ptype])) {
      continue;
    }
    $alias = $query->leftJoin('field_data_' . $field_name, $field_name,
      "%alias.entity_id = n.nid AND %alias.entity_type = 'node' AND %alias.deleted = 0");
    $query->condition($alias . '.' . $field_name . '_value', $prefs[$ptype], 'IN');
  }

  $result = $query->orderBy('n.created', 'ASC')->execute();

  $rows = array();
  foreach ($result as $row) {
    $rows[] = array(l($row->title, 'node/' . $row->nid));
  }

  return theme('table', array(
    'header' => array(t('Tournament')),
    'rows'   => $rows,
    'empty'  => t('No upcoming tournaments match your preferences.'),
  ));
}

function pool_tournament_player_list_page() {
  $players = entity_load_multiple('player');
  $rows    = array();
  foreach ($players as $player) {
    $rows[] = array(
      l($player->label(), 'player/' . $player->id()),
      check_plain($player->fargo_rating ?: '—'),
      check_plain($player->location ?: '—'),
    );
  }
  return theme('table', array(
    'header' => array(t('Name'), t('Fargo Rating'), t('Location')),
    'rows'   => $rows,
    'empty'  => t('No players found.'),
  ));
}

function pool_tournament_player_add_page() {
  $bundles = _pool_tournament_bundle_list('player.bundle');
  if (count($bundles) === 1) {
    $bundle = key($bundles);
    backdrop_goto('player/add/' . $bundle);
  }
  $items = array();
  foreach ($bundles as $bundle => $info) {
    $items[] = l($info['label'], 'player/add/' . $bundle);
  }
  return theme('item_list', array('items' => $items, 'title' => t('Choose player type')));
}

function pool_tournament_player_add_form_page($bundle_config) {
  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.forms');
  $player = entity_create('player', array('bundle' => $bundle_config['bundle']));
  return backdrop_get_form('pool_tournament_player_form', $player);
}

function pool_tournament_player_add_title($bundle) {
  $config = config_get('player.bundle.' . $bundle);
  return t('Add @type player', array('@type' => isset($config['label']) ? $config['label'] : $bundle));
}

// Named _view_page(), not _view() -- EntityPlusController::buildContent()
// auto-invokes any function named {module}_{entity_type}_view($entity,
// $view_mode, $langcode) as a hook (module_invoke_all($entityType . '_view',
// ...)). A function named pool_tournament_player_view() collided with that
// convention: viewing a player called entity_view(), which invoked this
// function again as the "hook", which called entity_view() again --
// unbounded recursion (confirmed: ballooned to 3GB+ RSS before being killed).
function pool_tournament_player_view_page($player) {
  // Backdrop's entity_view() takes the entity object directly
  // (EntityInterface $entity, $view_mode) -- not the Drupal-7-Entity-API
  // style entity_view($type, array($id => $entity), $view_mode).
  return entity_view($player, 'full');
}

function pool_tournament_ref_entity_list_page($entity_type) {
  $entities = entity_load_multiple($entity_type);
  $rows     = array();
  $path_map = array(
    'player_type' => 'player-type', 'game_type' => 'game-type',
    'tournament_type' => 'tournament-type', 'venue' => 'venue',
    'sanctioning_body' => 'sanctioning-body',
  );
  $base = $path_map[$entity_type];

  $extra_columns = _pool_tournament_ref_entity_extra_columns($entity_type);

  $header = array(t('Label'), t('Bundle'));
  foreach ($extra_columns as $column) {
    $header[] = $column['label'];
  }
  $header[] = t('Operations');

  foreach ($entities as $entity) {
    $row = array(
      l($entity->label(), $base . '/' . $entity->id()),
      check_plain($entity->bundle()),
    );
    foreach ($extra_columns as $column) {
      $property = $column['property'];
      $value = isset($entity->$property) ? $entity->$property : '';
      $row[] = check_plain($value);
    }
    $row[] = l(t('Edit'), $base . '/' . $entity->id() . '/edit') . ' | ' . l(t('Delete'), $base . '/' . $entity->id() . '/delete');
    $rows[] = $row;
  }

  return theme('table', array(
    'header' => $header,
    'rows'   => $rows,
    'empty'  => t('No @type records found.', array('@type' => $entity_type)),
  ));
}

/**
 * Extra per-entity-type columns to show on a ref entity listing page,
 * beyond the universal Label/Bundle -- each a base-table property already
 * present on the loaded entity object (none of the 5 ref entity types use
 * Field API for these, so no field_get_items() is needed).
 */
function _pool_tournament_ref_entity_extra_columns($entity_type) {
  switch ($entity_type) {
    case 'venue':
      return array(
        array('property' => 'address',     'label' => t('Address')),
        array('property' => 'city',        'label' => t('City')),
        array('property' => 'state',       'label' => t('State')),
        array('property' => 'zip',         'label' => t('Zip')),
        array('property' => 'phone',       'label' => t('Phone')),
        array('property' => 'num_tables',  'label' => t('Tables')),
      );
    case 'player_type':
      return array(
        array('property' => 'players_per_side', 'label' => t('Players per side')),
      );
    case 'sanctioning_body':
      return array(
        array('property' => 'rulebook_url', 'label' => t('Rulebook URL')),
      );
    default:
      return array();
  }
}

function pool_tournament_ref_entity_add_page($entity_type, $path) {
  $prefix_map = array(
    'player_type' => 'player_type.bundle', 'game_type' => 'game_type.bundle',
    'tournament_type' => 'tournament_type.bundle', 'venue' => 'venue.bundle',
    'sanctioning_body' => 'sanctioning_body.bundle',
  );
  $bundles = _pool_tournament_bundle_list($prefix_map[$entity_type]);
  if (count($bundles) === 1) {
    backdrop_goto($path . '/add/' . key($bundles));
  }
  $items = array();
  foreach ($bundles as $bundle => $info) {
    $items[] = l($info['label'], $path . '/add/' . $bundle);
  }
  return theme('item_list', array('items' => $items));
}

function pool_tournament_ref_entity_view($entity_type, $entity) {
  // Same entity_view() signature fix as pool_tournament_player_view_page().
  // No naming-collision risk here (unlike that function) since
  // "ref_entity_view" doesn't match {module}_{entity_type}_view for any of
  // player_type/game_type/tournament_type/venue.
  return entity_view($entity, 'full');
}

/**
 * Page callback for <path>/add/%bundle. Creates a new entity of the given
 * bundle before handing off to the generic entity form, which expects an
 * entity object -- the raw bundle machine name string from the URL is not
 * enough on its own (same shim needed for player/add/%bundle).
 */
function pool_tournament_ref_entity_add_form_page($entity_type, $bundle, $id_key, $cancel_path) {
  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.forms');
  $entity = entity_create($entity_type, array('bundle' => $bundle));
  return backdrop_get_form('pool_tournament_generic_entity_form', $entity_type, $entity, $id_key, $cancel_path);
}

// ---------------------------------------------------------------------------
// Player preferences access
// ---------------------------------------------------------------------------

function pool_tournament_player_preferences_access($player) {
  global $user;
  if (user_access('administer pool tournament') || user_access('manage players')) {
    return TRUE;
  }
  return user_access('edit own player') && isset($player->uid) && $player->uid == $user->uid;
}

// ---------------------------------------------------------------------------
// Node info — Tournament content type
// ---------------------------------------------------------------------------

/**
 * Implements hook_node_info().
 */
function pool_tournament_node_info() {
  return array(
    'tournament' => array(
      'name'        => t('Tournament'),
      'base'        => 'node_content',
      'description' => t('A pool tournament event.'),
      'has_title'   => TRUE,
      'title_label' => t('Tournament name'),
      'locked'      => FALSE,
    ),
  );
}

// ---------------------------------------------------------------------------
// Tournament node → bracket manager sync
// ---------------------------------------------------------------------------

/**
 * Whether a tournament node's registration is currently open
 * (field_registration_open's stored value -- Open=1/Closed=0, see
 * pool_tournament_tournament_node_form_alter()'s inverted "Do not open
 * registration yet" checkbox over this same field). This is a one-way
 * flag: once a save makes it TRUE, the form permanently disables the
 * checkbox, so "currently open" and "has ever been open" are the same
 * question -- no separate historical flag is needed.
 */
function _pool_tournament_registration_is_open($node) {
  return !empty($node->field_registration_open[LANGUAGE_NONE][0]['value']);
}

/**
 * Creates the tournament's bracket-manager container and runs the
 * match-against-preferences notification pass. Called exactly once per
 * tournament, at the moment registration actually opens -- either
 * immediately at creation (the common case) or later, from
 * pool_tournament_node_update(), when the TD unchecks a trial-balloon
 * tournament's "Do not open registration yet" box. Never called again
 * after that for the same tournament.
 */
function _pool_tournament_open_registration($node) {
  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.bracket');
  $result = pool_tournament_bracket_create_tournament($node->title);
  if ($result && !empty($result['id'])) {
    // Store the bracket manager ID back on the node.
    $node->field_bracket_manager_id[LANGUAGE_NONE][0]['value'] = $result['id'];
    // db_merge, not db_update -- avoids triggering a hook_node_update loop
    // the same as db_update would, but actually persists the value. The
    // field is empty until this point (nobody fills it in; it only ever
    // gets a value here), so no field_data/field_revision row exists yet
    // for it and db_update() would be a silent no-op.
    db_merge('field_data_field_bracket_manager_id')
      ->key(array(
        'entity_type' => 'node',
        'entity_id'   => $node->nid,
        'deleted'     => 0,
        'language'    => LANGUAGE_NONE,
        'delta'       => 0,
      ))
      ->fields(array(
        'bundle'                          => $node->type,
        'revision_id'                     => $node->vid,
        'field_bracket_manager_id_value'  => $result['id'],
      ))
      ->execute();
    db_merge('field_revision_field_bracket_manager_id')
      ->key(array(
        'entity_type' => 'node',
        'entity_id'   => $node->nid,
        'revision_id' => $node->vid,
        'deleted'     => 0,
        'language'    => LANGUAGE_NONE,
        'delta'       => 0,
      ))
      ->fields(array(
        'bundle'                          => $node->type,
        'field_bracket_manager_id_value'  => $result['id'],
      ))
      ->execute();
    watchdog('pool_tournament', 'Tournament node @nid synced to bracket manager ID @bid.',
      array('@nid' => $node->nid, '@bid' => $result['id']));
  }

  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.matching');
  pool_tournament_notify_matching_players($node);
}

/**
 * Implements hook_node_insert().
 */
function pool_tournament_node_insert($node) {
  if ($node->type !== 'tournament') {
    return;
  }
  _pool_tournament_save_tournament_extra($node);
  if (_pool_tournament_registration_is_open($node)) {
    _pool_tournament_open_registration($node);
  }
}

/**
 * Implements hook_node_update().
 */
function pool_tournament_node_update($node) {
  if ($node->type !== 'tournament') {
    return;
  }
  _pool_tournament_save_tournament_extra($node);

  // Registration can only ever transition Closed -> Open (the form
  // permanently disables the checkbox once Open), so comparing against
  // the previous revision is sufficient to detect that transition exactly
  // once -- this is the trial-balloon case: registration wasn't opened at
  // creation, and this save is what finally opens it.
  $was_open = isset($node->original) && _pool_tournament_registration_is_open($node->original);
  $is_open  = _pool_tournament_registration_is_open($node);
  if ($is_open && !$was_open) {
    _pool_tournament_open_registration($node);
    return;
  }

  $bid = _pool_tournament_get_bracket_id($node);
  if (!$bid) {
    return;
  }
  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.bracket');
  pool_tournament_bracket_rename_tournament($bid, $node->title);
}

/**
 * Implements hook_node_delete().
 */
function pool_tournament_node_delete($node) {
  if ($node->type !== 'tournament') {
    return;
  }
  db_delete('pool_tournament_tournament_extra')
    ->condition('nid', $node->nid)
    ->execute();
  db_delete('pool_tournament_registration')
    ->condition('nid', $node->nid)
    ->execute();
  $bid = _pool_tournament_get_bracket_id($node);
  if (!$bid) {
    return;
  }
  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.bracket');
  pool_tournament_bracket_delete_tournament($bid);
}

/**
 * Upserts the tournament's team_size, fargo_rating_ceiling, and td_uid
 * into pool_tournament_tournament_extra.
 *
 * team_size is only meaningful when the tournament's player_type resolves to
 * bundle 'team' (see pool_tournament_tournament_team_size_validate()).
 * fargo_rating_ceiling is only meaningful when the tournament's
 * tournament_type resolves to bundle fargo_limit(_handicapped) (see
 * pool_tournament_tournament_fargo_ceiling_validate()) -- it's a decision
 * the venue makes fresh for each tournament, not a property of the
 * tournament_type entity itself. td_uid (Tournament Director) is a plain
 * Backdrop user reference, not conditional on anything else. All three are
 * stored here rather than as Field API fields since they're single scalars
 * with no need for Field UI/Views integration.
 */
function _pool_tournament_save_tournament_extra($node) {
  // property_exists(), not isset() -- clearing a stale value legitimately
  // needs to persist an explicit NULL, and isset() treats an explicit NULL
  // the same as "never set".
  $fields = array();
  if (property_exists($node, 'team_size')) {
    $fields['team_size'] = $node->team_size ?: NULL;
  }
  if (property_exists($node, 'fargo_rating_ceiling')) {
    $fields['fargo_rating_ceiling'] = $node->fargo_rating_ceiling ?: NULL;
  }
  if (property_exists($node, 'td_uid')) {
    $fields['td_uid'] = $node->td_uid ?: NULL;
  }
  if (empty($fields)) {
    return;
  }
  db_merge('pool_tournament_tournament_extra')
    ->key(array('nid' => $node->nid))
    ->fields($fields)
    ->execute();
}

// ---------------------------------------------------------------------------
// Form alterations
// ---------------------------------------------------------------------------

/**
 * Implements hook_form_alter().
 */
function pool_tournament_form_alter(&$form, &$form_state, $form_id) {
  if ($form_id === 'tournament_node_form') {
    module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.forms');
    pool_tournament_tournament_node_form_alter($form, $form_state);
  }
}

// ---------------------------------------------------------------------------
// User–player relationship
// ---------------------------------------------------------------------------

/**
 * Implements hook_user_cancel().
 *
 * Unlinks the Backdrop user from their player record when the account is cancelled.
 */
function pool_tournament_user_cancel($edit, $account, $method) {
  db_update('pool_tournament_player')
    ->fields(array('uid' => NULL))
    ->condition('uid', $account->uid)
    ->execute();
}

/**
 * Implements hook_user_delete().
 */
function pool_tournament_user_delete($account) {
  db_update('pool_tournament_player')
    ->fields(array('uid' => NULL))
    ->condition('uid', $account->uid)
    ->execute();
}

/**
 * Returns the player entity linked to a Backdrop user, or FALSE.
 */
function pool_tournament_player_for_user($uid) {
  $result = entity_load('player', FALSE, array('uid' => $uid));
  return $result ? reset($result) : FALSE;
}

// ---------------------------------------------------------------------------
// Views integration
// ---------------------------------------------------------------------------

/**
 * Implements hook_views_query_alter().
 *
 * Filters the tournament listing by the logged-in player's preferences
 * when the view named 'pool_tournament_upcoming' is displayed.
 */
function pool_tournament_views_query_alter(&$view, &$query) {
  if ($view->name !== 'pool_tournament_upcoming') {
    return;
  }
  global $user;
  if (!$user->uid) {
    return;
  }
  $player = pool_tournament_player_for_user($user->uid);
  if (!$player) {
    return;
  }

  module_load_include('inc', 'pool_tournament', 'includes/pool_tournament.forms');
  $prefs = _pool_tournament_player_preferences_load($player->id());

  foreach (_pool_tournament_preference_field_map() as $ptype => $field_name) {
    if (empty($prefs[$ptype])) {
      continue;
    }
    $table = 'field_data_' . $field_name;
    $condition = db_or();
    foreach ($prefs[$ptype] as $entity_id) {
      $condition->condition($table . '.field_' . $ptype . '_id_value', $entity_id);
    }
    $query->add_where('preferences_' . $ptype, $condition);
  }
}

// ---------------------------------------------------------------------------
// Field extra fields (non-Field-API properties exposed to Manage Display)
// ---------------------------------------------------------------------------

/**
 * Implements hook_field_extra_fields().
 */
function pool_tournament_field_extra_fields() {
  $extra = array();

  $player_extras = array(
    'player_id'    => array('label' => t('Player ID'),     'weight' => -15),
    'label'        => array('label' => t('Full name'),     'weight' => -10),
    'member_id'    => array('label' => t('Member ID'),     'weight' => -5),
    'fargo_rating' => array('label' => t('Fargo Rating'),  'weight' => 0),
    'robustness'   => array('label' => t('Robustness'),    'weight' => 1),
    'location'     => array('label' => t('Location'),      'weight' => 2),
  );

  $bundles = config_get_names_with_prefix('player.bundle.');
  foreach ($bundles as $config_name) {
    $config = config_get($config_name);
    if (!empty($config['bundle'])) {
      foreach ($player_extras as $key => $info) {
        $extra['player'][$config['bundle']]['display'][$key] = $info;
        $extra['player'][$config['bundle']]['form'][$key]    = $info;
      }
    }
  }

  return $extra;
}

// ---------------------------------------------------------------------------
// Entity render
// ---------------------------------------------------------------------------

/**
 * Implements hook_entity_plus_view().
 */
function pool_tournament_entity_plus_view($entity, $entity_type, $view_mode, $langcode) {
  if ($entity_type === 'player') {
    $entity->content['label'] = array(
      '#markup' => '<div class="player-name"><strong>' . check_plain($entity->label) . '</strong></div>',
      '#weight' => -10,
    );
    if ($entity->fargo_rating) {
      $entity->content['fargo_rating'] = array(
        '#markup' => '<div class="fargo-rating">' . t('Fargo Rating: @r', array('@r' => $entity->fargo_rating)) . '</div>',
        '#weight' => 0,
      );
    }
    if ($entity->location) {
      $entity->content['location'] = array(
        '#markup' => '<div class="player-location">' . check_plain($entity->location) . '</div>',
        '#weight' => 2,
      );
    }
  }
}

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

/**
 * The 5 preference/matching dimensions, mapping preference_type (as stored
 * in pool_tournament_player_preference and returned by
 * _pool_tournament_player_preferences_load()) to the tournament node's
 * corresponding Field API field name. Shared by the /tournaments preference
 * filter, hook_views_query_alter() (dead code today, but kept accurate),
 * and the matching subsystem in pool_tournament.matching.inc -- previously
 * copy-pasted in three places with two slightly different shapes; this is
 * the one source of truth now.
 */
function _pool_tournament_preference_field_map() {
  return array(
    'game_type'        => 'field_game_type_id',
    'player_type'      => 'field_player_type_id',
    'tournament_type'  => 'field_tournament_type_id',
    'venue'            => 'field_venue_id',
    'sanctioning_body' => 'field_sanctioning_body_id',
  );
}

function _pool_tournament_bundle_list($config_prefix) {
  $bundles = array();
  $names   = config_get_names_with_prefix($config_prefix . '.');
  foreach ($names as $name) {
    $config = config_get($name);
    if (!empty($config['bundle'])) {
      $bundles[$config['bundle']] = $config;
    }
  }
  return $bundles;
}

function _pool_tournament_get_bracket_id($node) {
  if (isset($node->field_bracket_manager_id[LANGUAGE_NONE][0]['value'])) {
    return (int) $node->field_bracket_manager_id[LANGUAGE_NONE][0]['value'];
  }
  return 0;
}

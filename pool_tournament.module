  // ── Players ────────────────────────────────────────────────────────────────
  $items['players'] = array(
    'title'            => 'Players',
    'page callback'    => 'pool_tournament_player_list_page',
    'access arguments' => array('view players'),
    'type'             => MENU_NORMAL_ITEM,
  );
  $items['player/add'] = array(
    'title'            => 'Add player',
    'page callback'    => 'pool_tournament_player_add_page',
    'access arguments' => array('manage players'),
    'type'             => MENU_LOCAL_ACTION,
  );
  $items['player/add/%pool_tournament_player_bundle'] = array(
    'title callback'   => 'pool_tournament_player_add_title',
    'title arguments'  => array(2),
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_form', 2),
    'access arguments' => array('manage players'),
    'file'             => 'includes/pool_tournament.forms.inc',
  );
  $items['player/%pool_tournament_player'] = array(
    'title callback'   => 'entity_class_label',
    'title arguments'  => array(1),
    'page callback'    => 'pool_tournament_player_view',
    'page arguments'   => array(1),
    'access callback'  => 'pool_tournament_entity_access',
    'access arguments' => array('view', 1),
    'load arguments'   => array('%map', '%index'),
  );
  $items['player/%pool_tournament_player/view'] = array(
    'title'  => 'View',
    'type'   => MENU_DEFAULT_LOCAL_TASK,
    'weight' => -10,
  );
  $items['player/%pool_tournament_player/edit'] = array(
    'title'            => 'Edit',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_form', 1),
    'access callback'  => 'pool_tournament_entity_access',
    'access arguments' => array('update', 1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.forms.inc',
  );
  $items['player/%pool_tournament_player/delete'] = array(
    'title'            => 'Delete',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_delete_form', 1),
    'access callback'  => 'pool_tournament_entity_access',
    'access arguments' => array('delete', 1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.forms.inc',
  );
  $items['player/%pool_tournament_player/preferences'] = array(
    'title'            => 'Tournament preferences',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_player_preferences_form', 1),
    'access callback'  => 'pool_tournament_player_preferences_access',
    'access arguments' => array(1),
    'type'             => MENU_LOCAL_TASK,
    'file'             => 'includes/pool_tournament.forms.inc',
  );

  // ── Player bundle admin ────────────────────────────────────────────────────
  $items['admin/structure/player-bundle'] = array(
    'title'            => 'Player bundles',
    'page callback'    => 'pool_tournament_bundle_list_page',
    'page arguments'   => array('player', 'player.bundle', 'admin/structure/player-bundle'),
    'access arguments' => array('administer pool tournament'),
    'file'             => 'includes/pool_tournament.admin.inc',
  );
  $items['admin/structure/player-bundle/add'] = array(
    'title'            => 'Add bundle',
    'page callback'    => 'backdrop_get_form',
    'page arguments'   => array('pool_tournament_bundle_form', 'player.bundle'),
    'access arguments' => array('administer pool tournament'),
    'type'             => MENU_LOCAL_ACTION,
    'file'             => 'includes/pool_tournament.admin.inc',
  );

  // ── Reference entity routes (player_type, game_type, tournament_type, venue) ─
  $ref_entities = array(
    'player_type'     => array('path' => 'player-type',     'title' => 'Player Types',     'config' => 'player_type.bundle',     'id_key' => 'player_type_id'),
    'game_type'       => array('path' => 'game-type',       'title' => 'Game Types',       'config' => 'game_type.bundle',       'id_key' => 'game_type_id'),
    'tournament_type' => array('path' => 'tournament-type', 'title' => 'Tournament Types', 'config' => 'tournament_type.bundle', 'id_key' => 'tournament_type_id'),
    'venue'           => array('path' => 'venue',           'title' => 'Venues',           'config' => 'venue.bundle',           'id_key' => 'venue_id'),

/**
 * Delete stale bundle-admin menu links so Field UI's tabs reattach correctly.
 *
 * The bundle admin pages (admin/structure/*-bundle/<bundle>) didn't exist as
 * real menu items until this release, so Field UI's "Manage fields" / "Manage
 * displays" tabs, and this module's own per-bundle Edit/Delete tabs, all
 * pointed at the wrong parent in the admin menu tree. A plain menu_rebuild()
 * is not enough to fix this on a site that ran the earlier, broken menu
 * structure: Backdrop reuses existing menu_links rows' parent (plid) across
 * a rebuild rather than recomputing it when a path's intended parent
 * changes, so the stale rows have to be deleted first to force Backdrop to
 * recreate them with the correct parent.
 */
function pool_tournament_update_1000() {
  $bases = array(
    'admin/structure/player-bundle',
    'admin/structure/player-type-bundle',
    'admin/structure/game-type-bundle',
    'admin/structure/tournament-type-bundle',
    'admin/structure/venue-bundle',
  );
  foreach ($bases as $base) {
    db_delete('menu_links')
      ->condition('link_path', $base . '/%', 'LIKE')
      ->execute();
  }
  menu_rebuild();
}

/**
 * Create pool_tournament_tournament_extra for sites installed before it
 * was added to the schema.
 */
function pool_tournament_update_1001() {
  if (!db_table_exists('pool_tournament_tournament_extra')) {
    $schema = pool_tournament_schema();
    db_create_table('pool_tournament_tournament_extra', $schema['pool_tournament_tournament_extra']);
  }
}

/**
 * Add membership_id to pool_tournament_player (Fargo's membershipId --
 * distinct from readableId/member_id).
 */
function pool_tournament_update_1002() {
  if (!db_field_exists('pool_tournament_player', 'membership_id')) {
    $schema = pool_tournament_schema();
    db_add_field('pool_tournament_player', 'membership_id', $schema['pool_tournament_player']['fields']['membership_id']);
  }
}

/**
 * Add the sanctioning_body entity type (table, default bundle) and the
 * field_sanctioning_body_id field on the tournament node.
 */
function pool_tournament_update_1003() {
  if (!db_table_exists('pool_tournament_sanctioning_body')) {
    $schema = pool_tournament_schema();
    db_create_table('pool_tournament_sanctioning_body', $schema['pool_tournament_sanctioning_body']);
  }

  if (!config_get('sanctioning_body.bundle.sanctioning_body')) {
    config('sanctioning_body.bundle.sanctioning_body')
      ->set('_config_name', 'sanctioning_body.bundle.sanctioning_body')
      ->set('bundle', 'sanctioning_body')
      ->set('label', 'Sanctioning Body')
      ->save();
    field_attach_create_bundle('sanctioning_body', 'sanctioning_body');
  }

  if (!field_info_field('field_sanctioning_body_id')) {
    field_create_field(array(
      'field_name'  => 'field_sanctioning_body_id',
      'type'        => 'number_integer',
      'cardinality' => 1,
    ));
  }
  if (!field_info_instance('node', 'field_sanctioning_body_id', 'tournament')) {
    field_create_instance(array(
      'field_name'  => 'field_sanctioning_body_id',
      'entity_type' => 'node',
      'bundle'      => 'tournament',
      'label'       => t('Sanctioning Body'),
      'required'    => FALSE,
      'widget'      => array('type' => 'number'),
    ));
  }
}

/**
 * Seed the four major US pool sanctioning bodies with links to their
 * official rules, so the tournament form has real options out of the box.
 * Idempotent -- safe to run again, skips any label already present.
 */
function pool_tournament_update_1004() {
  $bodies = array(
    'BCA' => array(
      'description'  => 'BCA Pool League (BCAPL), operated by CueSports International (CSI). Uses Fargo Rate handicapping and official CSI/BCA rules.',
      'rulebook_url' => 'https://www.playcsipool.com/bcapl-rules.html',
    ),
    'CSI' => array(
      'description'  => 'CueSports International -- parent organization operating the BCA Pool League and USA Pool League.',
      'rulebook_url' => 'https://www.playcsipool.com/tournament-regulations.html',
    ),
    'APA' => array(
      'description'  => 'American Poolplayers Association. Uses the proprietary Equalizer handicap system.',
      'rulebook_url' => 'https://rules.poolplayers.com/',
    ),
    'ACS' => array(
      'description'  => 'American CueSports Alliance. Uses the WPA World Standardized Rules.',
      'rulebook_url' => 'https://americancuesports.org/world-standardized-rules/',
    ),
  );

  $existing = db_select('pool_tournament_sanctioning_body', 's')
    ->fields('s', array('label'))
    ->execute()->fetchCol();

  foreach ($bodies as $label => $data) {
    if (in_array($label, $existing)) {
      continue;
    }
    db_insert('pool_tournament_sanctioning_body')
      ->fields(array(
        'bundle'       => 'sanctioning_body',
        'label'        => $label,
        'description'  => $data['description'],
        'rulebook_url' => $data['rulebook_url'],
        'created'      => REQUEST_TIME,
      ))
      ->execute();
  }
}

/**
 * Simplify the sanctioning body roster to just BCA and APA -- what small
 * local venue operators (the actual target users of this app) run, per
 * the site owner: "almost all will be APA." Removes CSI and ACS, added
 * in pool_tournament_update_1004(). Clears any tournament node's
 * reference first so a removal never leaves a dangling FK.
 */
function pool_tournament_update_1005() {
  $to_remove = db_select('pool_tournament_sanctioning_body', 's')
    ->fields('s', array('sanctioning_body_id'))
    ->condition('label', array('CSI', 'ACS'), 'IN')
    ->execute()->fetchCol();

  if (empty($to_remove)) {
    return;
  }

  if (db_table_exists('field_data_field_sanctioning_body_id')) {
    $affected_nids = db_select('field_data_field_sanctioning_body_id', 'f')
      ->fields('f', array('entity_id'))
      ->condition('field_sanctioning_body_id_value', $to_remove, 'IN')
      ->execute()->fetchCol();
    foreach ($affected_nids as $nid) {
      db_update('field_data_field_sanctioning_body_id')
        ->fields(array('field_sanctioning_body_id_value' => NULL))
        ->condition('entity_id', $nid)
        ->execute();
      if (db_table_exists('field_revision_field_sanctioning_body_id')) {
        db_update('field_revision_field_sanctioning_body_id')
          ->fields(array('field_sanctioning_body_id_value' => NULL))
          ->condition('entity_id', $nid)
          ->execute();
      }
    }
  }

  db_delete('pool_tournament_sanctioning_body')
    ->condition('sanctioning_body_id', $to_remove, 'IN')
    ->execute();
}

/**
 * Implements hook_uninstall().
 */
function pool_tournament_uninstall() {
  // Remove tournament content type and its fields.
  $fields = array(
    'field_tournament_date',
    'field_bracket_manager_id',
    'field_game_type_id',
    'field_player_type_id',
    'field_tournament_type_id',
    'field_venue_id',
    'field_sanctioning_body_id',
    'field_max_players',
    'field_registration_open',
  );
  foreach ($fields as $field_name) {
    $instance = field_info_instance('node', $field_name, 'tournament');
    if ($instance) {
      field_delete_instance($instance);
    }
    $field = field_info_field($field_name);
    if ($field) {
      field_delete_field($field_name);
    }
  }

  // Purge field data.
  field_purge_batch(1000);

  // Delete content type.
  node_type_delete('tournament');
}

      'instance' => array(
        'field_name'  => 'field_tournament_date',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Tournament Date'),
        'description' => t('Unix timestamp of the tournament date/time.'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
        'display'     => array(
          'default' => array('label' => 'above', 'type' => 'number_integer'),
        ),
      ),
    ),
    'field_bracket_manager_id' => array(
      'field' => array(
        'field_name'  => 'field_bracket_manager_id',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_bracket_manager_id',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Bracket Manager Tournament ID'),
        'description' => t('The corresponding tournament ID in the bracket manager application.'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
      ),
    ),
    'field_game_type_id' => array(
      'field' => array(
        'field_name'  => 'field_game_type_id',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_game_type_id',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Game Type'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
      ),
    ),
    'field_player_type_id' => array(
      'field' => array(
        'field_name'  => 'field_player_type_id',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_player_type_id',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Player Type'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
      ),
    ),
    'field_tournament_type_id' => array(
      'field' => array(
        'field_name'  => 'field_tournament_type_id',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_tournament_type_id',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Tournament Type'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
      ),
    ),
    'field_venue_id' => array(
      'field' => array(
        'field_name'  => 'field_venue_id',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_venue_id',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Venue'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
      ),
    ),
    'field_sanctioning_body_id' => array(
      'field' => array(
        'field_name'  => 'field_sanctioning_body_id',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_sanctioning_body_id',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Sanctioning Body'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
      ),
    ),
    'field_max_players' => array(
      'field' => array(
        'field_name'  => 'field_max_players',
        'type'        => 'number_integer',
        'cardinality' => 1,
      ),
      'instance' => array(
        'field_name'  => 'field_max_players',
        'entity_type' => 'node',
        'bundle'      => 'tournament',
        'label'       => t('Maximum Players'),
        'required'    => FALSE,
        'widget'      => array('type' => 'number'),
